{
    "name": "5Link-monorepo",
    "private": true,
    "version": "1.0.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -n \"FE,BE\" -c \"red,blue\"  \"npm run dev:web\" \"npm run dev:server\"",
        "dev:server": "npm run dev --workspace=server",
        "dev:web": "npm run dev --workspace=web",
        "build": "npm run build --workspaces --if-present"
    },
    "devDependencies": {
        "concurrently": "^10.0.6"
    }
}
